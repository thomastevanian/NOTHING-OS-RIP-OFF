<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_bg_card">

    <TextView
        android:id="@+id/widget_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:08"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:textStyle="bold"
        android:fontFamily="@font/doto"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/widget_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="THU, OCT 8"
        android:textColor="#8A8A8A"
        android:textSize="12sp"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0.1" />
</LinearLayout>
