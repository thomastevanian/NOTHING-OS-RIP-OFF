<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_bg_card">

    <TextView
        android:id="@+id/widget_weather_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="21°C"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="@font/doto" />

    <TextView
        android:id="@+id/widget_weather_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="CLEAR SKY"
        android:textColor="#8A8A8A"
        android:textSize="11sp"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0.1" />
</LinearLayout>
